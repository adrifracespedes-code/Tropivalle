<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tropivalle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
@{
    var isHome = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
              && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}
<header>
    <nav class="navbar navbar-expand-lg navbar-tropivalle fixed-top @(isHome ? "nav-on-hero" : "")">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="brand-leaf"><i class="bi bi-leaf-fill"></i></span>
                <span class="brand-text">Tropivalle</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link nav-item-link" asp-controller="Products" asp-action="Index">Nuestros jugos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-link" href="@(isHome ? "#nosotros" : Url.Action("Index", "Home") + "#nosotros")">Nosotros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-link" href="@(isHome ? "#ingredientes" : Url.Action("Index", "Home") + "#ingredientes")">Ingredientes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-link" href="@(isHome ? "#sostenibilidad" : Url.Action("Index", "Home") + "#sostenibilidad")">Sostenibilidad</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-item-link" asp-controller="Products" asp-action="Index">Tienda</a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Sales" asp-action="Index">Ventas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link" asp-controller="Products" asp-action="Create">Nuevo producto</a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 flex-wrap mt-3 mt-lg-0">
                    <a class="btn btn-nav-outline" asp-controller="Products" asp-action="Index">
                        <i class="bi bi-leaf me-1"></i>Conoce nuestros jugos
                    </a>
                    <a class="btn btn-buy" asp-controller="Products" asp-action="Index">
                        Comprar ahora <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="nav-user small d-none d-xl-inline">
                            <i class="bi bi-person-circle me-1"></i>@(User.Identity.Name)
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-nav-outline btn-sm">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-nav-outline btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="@(isHome ? "main-home" : "main-default") flex-grow-1">
    @if (TempData["Success"] is string success)
    {
        <div class="container" style="padding-top: calc(var(--nav-h) + 1rem);">
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i>@success
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @RenderBody()
</main>

<footer class="footer-tv">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4 text-center text-md-start">
                <div class="footer-brand"><i class="bi bi-leaf-fill me-1"></i>Tropivalle</div>
                <div class="footer-tag">Industrias Alimenticias TropiValle</div>
                <div class="footer-tag mt-1">Néctares · Agua de mesa · Cochabamba</div>
            </div>
            <div class="col-md-4 text-center">
                <div class="footer-brand mb-1"><i class="bi bi-telephone me-1"></i>Contacto</div>
                <a class="footer-link" href="tel:+59175950776">+591-7-595-0776</a>
            </div>
            <div class="col-md-4 text-center text-md-end">
                <div class="footer-brand mb-1"><i class="bi bi-geo-alt me-1"></i>Ubicación</div>
                <div class="footer-tag">
                    Calle Salazar No. 1691 entre Calle Rossety y Av. Cañada<br />
                    Zona La Chimba · Cochabamba, Bolivia
                </div>
                <a class="footer-link small" href="https://maps.app.goo.gl/TuPeeuGRz8Dcdhto9" target="_blank" rel="noopener">
                    Ver en Google Maps <i class="bi bi-box-arrow-up-right"></i>
                </a>
            </div>
        </div>
        <hr class="footer-hr my-3" />
        <div class="text-center small opacity-75">
            &copy; @DateTime.Now.Year TropiValle — No realice pagos a desconocidos.
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
