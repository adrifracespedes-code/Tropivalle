<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tropivalle</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-tropivalle">
        <div class="container">
            <a class="navbar-brand" asp-controller="Products" asp-action="Index">
                <i class="bi bi-droplet-half me-1"></i>Tropi<span>valle</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Products" asp-action="Index">
                            <i class="bi bi-grid me-1"></i>Productos
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i>Nuevo producto
                            </a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-white small">
                            <i class="bi bi-person-circle me-1"></i>@(User.Identity.Name)
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light-tv btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light-tv btn-sm" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                        <a class="btn btn-light-tv btn-sm" asp-controller="Account" asp-action="Register">Registrarse</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4 flex-grow-1">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-1"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</main>

<footer class="py-4">
    <div class="container text-center small">
        <div class="mb-1 fw-semibold">
            <i class="bi bi-droplet-half me-1"></i>Tropivalle — Jugos naturales del valle
        </div>
        <div class="opacity-75">
            Botellas individuales · Paquetes de 12 · 100% natural
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
