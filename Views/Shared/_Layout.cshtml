<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tropivalle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/asistente-voz.css" asp-append-version="true" />
    <meta name="theme-color" content="#0d3b2a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TropiValle" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/icons/icon-192.png" />
</head>
<body class="d-flex flex-column min-vh-100" data-is-admin="@(User.IsInRole("Admin") ? "true" : "false")">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var isHome = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
                  && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
        var isShop = string.Equals(controller, "Products", StringComparison.OrdinalIgnoreCase);
        var isSales = string.Equals(controller, "Sales", StringComparison.OrdinalIgnoreCase);
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-tropivalle fixed-top @(isHome ? "nav-on-hero" : "")" id="mainNav">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" title="TropiValle">
                    <img src="~/images/logo-tropivalle.png" alt="TropiValle" class="brand-logo" asp-append-version="true" />
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-1 nav-pills-tv">
                        <li class="nav-item">
                            <a class="nav-link nav-item-link @(isHome ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door d-lg-none me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-item-link @(isShop ? "active" : "")"
                               asp-controller="Products" asp-action="Index">
                                <i class="bi bi-bag-heart d-lg-none me-1"></i>Tienda
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-item-link dropdown-toggle" href="#" id="contactoMenu"
                               role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-chat-dots d-lg-none me-1"></i>Contacto
                            </a>
                            <ul class="dropdown-menu dropdown-menu-tv shadow-lg border-0" aria-labelledby="contactoMenu">
                                <li>
                                    <a class="dropdown-item" href="tel:+59175950776">
                                        <span class="dd-icon"><i class="bi bi-telephone-fill"></i></span>
                                        <span>
                                            <strong>Llamar</strong>
                                            <small class="d-block text-muted">+591 7 595 0776</small>
                                        </span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://wa.me/59175950776?text=Hola%20TropiValle%2C%20quiero%20información%20de%20productos"
                                       target="_blank" rel="noopener">
                                        <span class="dd-icon wa"><i class="bi bi-whatsapp"></i></span>
                                        <span>
                                            <strong>WhatsApp</strong>
                                            <small class="d-block text-muted">Escribir ahora</small>
                                        </span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" href="https://maps.app.goo.gl/TuPeeuGRz8Dcdhto9"
                                       target="_blank" rel="noopener">
                                        <span class="dd-icon map"><i class="bi bi-geo-alt-fill"></i></span>
                                        <span>
                                            <strong>Ubicación</strong>
                                            <small class="d-block text-muted">Zona La Chimba, Cbba</small>
                                        </span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-item-link @(isSales ? "active" : "")"
                                   asp-controller="Sales" asp-action="Index">
                                    <i class="bi bi-graph-up d-lg-none me-1"></i>Ventas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-item-link"
                                   asp-controller="Products" asp-action="Create">
                                    <i class="bi bi-plus-circle d-lg-none me-1"></i>Nuevo producto
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-wrap mt-3 mt-lg-0 nav-actions">
                        <button type="button" class="btn btn-nav-outline btn-sm" id="pwaInstallBtn" style="display:none" title="Instalar app">
                            <i class="bi bi-download me-1"></i>Instalar app
                        </button>
                        <a class="btn btn-buy" asp-controller="Products" asp-action="Index">
                            Comprar ahora <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="nav-user d-none d-xl-inline-flex align-items-center">
                                <i class="bi bi-person-circle me-1"></i>
                                <span class="nav-user-name">@(User.Identity.Name)</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-nav-outline btn-sm">Salir</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-nav-outline btn-sm" asp-controller="Account" asp-action="Login">Entrar</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="@(isHome ? "main-home" : "main-default") flex-grow-1">
        @if (TempData["Success"] is string success)
        {
            <div class="container" style="padding-top: calc(var(--nav-h) + 1rem);">
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-1"></i>@success
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container" style="padding-top: calc(var(--nav-h) + 1rem);">
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle me-1"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="footer-tv">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4 text-center text-md-start">
                    <div class="footer-brand d-flex align-items-center gap-2 justify-content-center justify-content-md-start">
                        <img src="~/images/logo-tropivalle.png" alt="TropiValle" class="footer-logo" asp-append-version="true" />
                    </div>
                    <div class="footer-tag">Industrias Alimenticias TropiValle</div>
                    <div class="footer-tag mt-1">Néctares · Agua de mesa · Cochabamba</div>
                </div>
                <div class="col-md-4 text-center">
                    <div class="footer-brand mb-1"><i class="bi bi-telephone me-1"></i>Contacto</div>
                    <a class="footer-link" href="tel:+59175950776">+591-7-595-0776</a>
                    <div class="mt-2">
                        <a class="footer-link" href="https://wa.me/59175950776" target="_blank" rel="noopener">
                            <i class="bi bi-whatsapp me-1"></i>WhatsApp
                        </a>
                    </div>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <div class="footer-brand mb-1"><i class="bi bi-geo-alt me-1"></i>Ubicación</div>
                    <div class="footer-tag">
                        Calle Salazar No. 1691 entre Calle Rossety y Av. Cañada<br />
                        Zona La Chimba · Cochabamba, Bolivia
                    </div>
                    <a class="footer-link small" href="https://maps.app.goo.gl/TuPeeuGRz8Dcdhto9" target="_blank" rel="noopener">
                        Ver en Google Maps <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
            </div>
            <hr class="footer-hr my-3" />
            <div class="text-center small opacity-75">
                &copy; @DateTime.Now.Year TropiValle — No realice pagos a desconocidos.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/asistente-voz.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>