@model IReadOnlyList<EcommerceApp.Controllers.ProductSlideVm>
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-mock panel-window panel-hero hero-mock--forest">
    <div class="hero-forest" aria-hidden="true">
        <div class="forest-mist forest-mist-a"></div>
        <div class="forest-mist forest-mist-b"></div>
        <div class="forest-canopy"></div>
        <div class="forest-trees forest-trees-back"></div>
        <div class="forest-trees forest-trees-front"></div>
        <div class="forest-ground"></div>
    </div>
    <div class="hero-orbs" aria-hidden="true">
        <span class="orb orb-a"></span>
        <span class="orb orb-b"></span>
        <span class="orb orb-c"></span>
    </div>
    @* Gotas de agua en el hero. Para DESACTIVAR: añade class "hero-mock--no-rain" a la section.hero-mock *@
    <div class="hero-rain" aria-hidden="true">
        <span class="drop" style="--x:37%;--d:0.37s;--t:2.75s;--s:3px;--o:0.33"></span>
        <span class="drop" style="--x:74%;--d:0.74s;--t:3.10s;--s:4px;--o:0.41"></span>
        <span class="drop" style="--x:11%;--d:1.11s;--t:3.45s;--s:5px;--o:0.49"></span>
        <span class="drop" style="--x:48%;--d:1.48s;--t:3.80s;--s:6px;--o:0.57"></span>
        <span class="drop" style="--x:85%;--d:1.85s;--t:4.15s;--s:2px;--o:0.65"></span>
        <span class="drop" style="--x:22%;--d:2.22s;--t:4.50s;--s:3px;--o:0.25"></span>
        <span class="drop" style="--x:59%;--d:2.59s;--t:2.40s;--s:4px;--o:0.33"></span>
        <span class="drop" style="--x:96%;--d:2.96s;--t:2.75s;--s:5px;--o:0.41"></span>
        <span class="drop" style="--x:33%;--d:3.33s;--t:3.10s;--s:6px;--o:0.49"></span>
        <span class="drop" style="--x:70%;--d:3.70s;--t:3.45s;--s:2px;--o:0.57"></span>
        <span class="drop" style="--x:7%;--d:4.07s;--t:3.80s;--s:3px;--o:0.65"></span>
        <span class="drop" style="--x:44%;--d:4.44s;--t:4.15s;--s:4px;--o:0.25"></span>
        <span class="drop" style="--x:81%;--d:4.81s;--t:4.50s;--s:5px;--o:0.33"></span>
        <span class="drop" style="--x:18%;--d:5.18s;--t:2.40s;--s:6px;--o:0.41"></span>
        <span class="drop" style="--x:55%;--d:5.55s;--t:2.75s;--s:2px;--o:0.49"></span>
        <span class="drop" style="--x:92%;--d:5.92s;--t:3.10s;--s:3px;--o:0.57"></span>
        <span class="drop" style="--x:29%;--d:0.29s;--t:3.45s;--s:4px;--o:0.65"></span>
        <span class="drop" style="--x:66%;--d:0.66s;--t:3.80s;--s:5px;--o:0.25"></span>
        <span class="drop" style="--x:3%;--d:1.03s;--t:4.15s;--s:6px;--o:0.33"></span>
        <span class="drop" style="--x:40%;--d:1.40s;--t:4.50s;--s:2px;--o:0.41"></span>
        <span class="drop" style="--x:77%;--d:1.77s;--t:2.40s;--s:3px;--o:0.49"></span>
        <span class="drop" style="--x:14%;--d:2.14s;--t:2.75s;--s:4px;--o:0.57"></span>
        <span class="drop" style="--x:51%;--d:2.51s;--t:3.10s;--s:5px;--o:0.65"></span>
        <span class="drop" style="--x:88%;--d:2.88s;--t:3.45s;--s:6px;--o:0.25"></span>
        <span class="drop" style="--x:25%;--d:3.25s;--t:3.80s;--s:2px;--o:0.33"></span>
        <span class="drop" style="--x:62%;--d:3.62s;--t:4.15s;--s:3px;--o:0.41"></span>
        <span class="drop" style="--x:99%;--d:3.99s;--t:4.50s;--s:4px;--o:0.49"></span>
        <span class="drop" style="--x:36%;--d:4.36s;--t:2.40s;--s:5px;--o:0.57"></span>
    </div>
    <div class="container hero-inner">
        <div class="hero-copy">
            <h1 class="hero-headline animate-in" id="heroHeadline" style="--d:0.15s">
                Refrescos naturales<br />
                que cruzan el<br />
                <span class="accent">sabor con la vida</span>
            </h1>
            <div class="hero-rule animate-in" style="--d:0.3s"></div>
            <p class="hero-lead animate-in" style="--d:0.4s">
                Jugos naturales, hechos con fruta real.<br />
                Sin conservadores. Solo sabor que te conecta.
            </p>
            <a asp-controller="Products" asp-action="Index" class="hero-explore animate-in" style="--d:0.55s">
                <span class="explore-circle"><i class="bi bi-arrow-up-right"></i></span>
                <span class="explore-text">
                    <strong>Explora los sabores</strong>
                    <small>100% naturales</small>
                </span>
            </a>
        </div>
    </div>
    <div class="hero-wordmark" aria-hidden="true">TROPIVALLE</div>
</section>

<section id="nosotros" class="home-section nosotros-section panel-window">
    <div class="container">
        <div class="nosotros-grid">
            <div class="nosotros-copy">
                <p class="sec-label">Nosotros</p>
                <h2 class="sec-title">Del valle a tu mesa</h2>
                <div class="sec-line"></div>
                <p class="sec-text">
                    En el corazón de Cochabamba nace TropiValle: néctares y agua de mesa
                    elaborados con fruta real y procesos limpios. No es solo una bebida —
                    es el sabor del valle embotellado para el día a día.
                </p>
                <p class="sec-text sec-text-soft">
                    Trabajamos sabores que la gente reconoce y elige: durazno, manzana, tumbo
                    y el frescor de nuestra agua de mesa. Desde la botella individual hasta
                    el pack familiar, siempre con la misma promesa: natural, honesto, de aquí.
                </p>
                <div class="d-flex flex-wrap gap-2 mt-3 mb-4">
                    <span class="tag-pill">100% natural</span>
                    <span class="tag-pill">Sin conservantes</span>
                    <span class="tag-pill">Fruta real</span>
                    <span class="tag-pill">Hecho en Bolivia</span>
                </div>
                <div class="story-stats">
                    <div class="story-stat">
                        <strong>10+</strong>
                        <span>presentaciones</span>
                    </div>
                    <div class="story-stat">
                        <strong>Cbba</strong>
                        <span>origen local</span>
                    </div>
                    <div class="story-stat">
                        <strong>0</strong>
                        <span>colorantes</span>
                    </div>
                </div>
            </div>

            <div class="nosotros-hero-card" id="nosotrosHeroCard" aria-label="Productos del stock">
                <div class="nosotros-hero-inner">
                    @{
                        var productImgs = Model ?? Array.Empty<EcommerceApp.Controllers.ProductSlideVm>();
                    }
                    @if (productImgs.Count == 0)
                    {
                        <div class="nosotros-slide is-active">
                            <img src="/images/nectar-1l-retornable.jpg" alt="TropiValle" />
                            <span class="nosotros-slide-caption">TropiValle</span>
                        </div>
                    }
                    else
                    {
                        @for (var i = 0; i < productImgs.Count; i++)
                        {
                            var img = productImgs[i];
                            <div class="nosotros-slide @(i == 0 ? "is-active" : "")" data-index="@i">
                                <img src="@img.ImageUrl" alt="@img.Name" loading="@(i == 0 ? "eager" : "lazy")" />
                                <span class="nosotros-slide-caption">@img.Name</span>
                            </div>
                        }
                    }
                </div>
                <div class="nosotros-dots" role="tablist" aria-label="Productos">
                    @for (var i = 0; i < productImgs.Count; i++)
                    {
                        <button type="button"
                                class="nosotros-dot @(i == 0 ? "is-active" : "")"
                                data-go="@i"
                                aria-label="Ver @productImgs[i].Name"></button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section id="ingredientes" class="home-section home-section-alt panel-window">
    <div class="container">
        <div class="section-head-row">
            <div>
                <p class="sec-label">Ingredientes</p>
                <h2 class="sec-title">Solo lo esencial</h2>
                <div class="sec-line"></div>
            </div>
            <p class="sec-text sec-text-side">
                Menos lista de químicos. Más fruta, agua limpia y el cuidado de siempre.
                Así se siente un trago de verdad.
            </p>
        </div>

        <div class="row g-4 mt-1">
            <div class="col-md-4">
                <div class="info-card info-card-rich">
                    <div class="info-card-top">
                        <span class="info-num">01</span>
                        <i class="bi bi-droplet-half"></i>
                    </div>
                    <h3>Fruta del valle</h3>
                    <p>
                        Durazno, manzana y tumbo en su punto. Elegimos madurez real
                        para que el néctar sepa a fruta, no a jarabe.
                    </p>
                    <ul class="info-list">
                        <li>Sabores reconocibles</li>
                        <li>Sin esencias artificiales</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card info-card-rich">
                    <div class="info-card-top">
                        <span class="info-num">02</span>
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3>Sin aditivos de más</h3>
                    <p>
                        Cero colorantes, conservadores ni azúcares artificiales de relleno.
                        Lo que ves en la etiqueta es lo que tomas.
                    </p>
                    <ul class="info-list">
                        <li>Receta limpia</li>
                        <li>Transparencia total</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card info-card-rich">
                    <div class="info-card-top">
                        <span class="info-num">03</span>
                        <i class="bi bi-recycle"></i>
                    </div>
                    <h3>Formato para tu ritmo</h3>
                    <p>
                        Retornable, descartable, pack o botellón. Para la mesa, la tienda
                        o el trabajo — el mismo estándar TropiValle.
                    </p>
                    <ul class="info-list">
                        <li>300 ml a 20 litros</li>
                        <li>Packs de 6 y 12</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="flavor-strip mt-5">
            <span class="flavor-strip-label">Sabores que viven en el valle</span>
            <div class="flavor-chips">
                <span class="flavor-chip">Durazno</span>
                <span class="flavor-chip">Manzana</span>
                <span class="flavor-chip">Tumbo</span>
                <span class="flavor-chip">Agua de mesa</span>
            </div>
        </div>
    </div>
</section>

<section id="sostenibilidad" class="home-section panel-window">
    <div class="container">
        <div class="sosten-grid">
            <div>
                <p class="sec-label">Sostenibilidad</p>
                <h2 class="sec-title">Cuidamos el origen</h2>
                <div class="sec-line"></div>
                <p class="sec-text">
                    Creemos que una buena botella empieza en el campo y termina en tu mesa
                    sin perder el respeto por el entorno. Por eso priorizamos productores
                    cercanos, empaques útiles y procesos que no complican de más lo natural.
                </p>
                <p class="sec-text sec-text-soft">
                    Cada presentación —del néctar de 300 ml al botellón de 20 litros—
                    está pensada para durar en el uso real: casa, negocio y distribución local.
                </p>
                <blockquote class="sosten-quote">
                    “Cada botella es un pequeño ritual de frescura y compromiso con el valle.”
                </blockquote>
            </div>
            <div class="sosten-panel">
                <h3 class="sosten-panel-title">Nuestro compromiso</h3>
                <ul class="sosten-checks">
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <div>
                            <strong>Origen local</strong>
                            <span>Cochabamba y alrededores como base de sabor</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <div>
                            <strong>Menos química, más verdad</strong>
                            <span>Sin colorantes ni conservantes artificiales</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <div>
                            <strong>Formatos responsables</strong>
                            <span>Retornables, packs y botellón según el uso</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-check-circle-fill"></i>
                        <div>
                            <strong>Cercanía con el cliente</strong>
                            <span>Atención directa y distribución en la zona</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="tienda" class="home-cta panel-window panel-cta">
    <div class="container text-center">
        <p class="cta-kicker">Listo para la mesa</p>
        <h2 class="cta-title">Descubre el sabor del valle</h2>
        <p class="cta-sub">
            Néctares · Agua de Mesa · Cochabamba<br />
            <span class="cta-sub-soft">Pedí por WhatsApp o revisá el catálogo completo</span>
        </p>
        <div class="cta-actions">
            <a asp-controller="Products" asp-action="Index" class="btn btn-buy btn-lg">
                Ver catálogo <i class="bi bi-arrow-right ms-1"></i>
            </a>
            <a href="https://wa.me/59175950776" class="btn btn-cta-ghost" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp me-1"></i> WhatsApp
            </a>
        </div>
    </div>
</section>
