@model Product
@{
    ViewData["Title"] = "Editar producto";
    var currentImg = Model?.ImageUrl;
}

<div class="page-header">
    <h1 class="mb-1" style="color: var(--tv-green-dark);">Editar producto</h1>
    <div class="section-divider"></div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-7">
        <div class="card product-card p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Categoría</label>
                    <select asp-for="Category" class="form-select">
                        <option value="">— Seleccionar —</option>
                        <option value="Nectar TropiValle">Nectar TropiValle</option>
                        <option value="Agua de Mesa">Agua de Mesa</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3 p-3 rounded border bg-light">
                    <label class="form-label fw-semibold mb-2">
                        <i class="bi bi-image me-1"></i>Imagen del producto
                    </label>
                    <p class="small text-muted mb-2">
                        Sube un archivo desde la PC <strong>o</strong> cambia la URL.
                        Si subes archivo, reemplaza la imagen actual. Si dejas ambos vacíos, se mantiene la actual.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(currentImg))
                    {
                        <div class="mb-3">
                            <div class="small text-muted mb-1">Imagen actual</div>
                            <img src="@currentImg" alt="Actual" class="img-thumbnail"
                                 style="max-height: 140px; object-fit: contain;"
                                 onerror="this.style.display='none'" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="imageFile">Subir nueva desde la PC</label>
                        <input type="file" name="imageFile" id="imageFile" class="form-control"
                               accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif" />
                        <div class="form-text">JPG, PNG, WEBP o GIF · máximo 5 MB</div>
                    </div>

                    <div class="mb-2 text-center text-muted small">— o URL —</div>

                    <div class="mb-2">
                        <label asp-for="ImageUrl" class="form-label">URL de imagen</label>
                        <input asp-for="ImageUrl" class="form-control" id="ImageUrl"
                               placeholder="/images/... o https://..." />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="mt-2">
                        <img id="imagePreview" src="" alt="Vista previa nueva" class="img-thumbnail d-none"
                             style="max-height: 180px; object-fit: contain;" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Guardar cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var fileInput = document.getElementById('imageFile');
            var urlInput = document.getElementById('ImageUrl');
            var preview = document.getElementById('imagePreview');

            function showPreview(src) {
                if (!src) {
                    preview.classList.add('d-none');
                    preview.removeAttribute('src');
                    return;
                }
                preview.src = src;
                preview.classList.remove('d-none');
            }

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    var f = fileInput.files && fileInput.files[0];
                    if (f) showPreview(URL.createObjectURL(f));
                });
            }
            if (urlInput) {
                urlInput.addEventListener('input', function () {
                    if (fileInput && fileInput.files && fileInput.files.length) return;
                    showPreview(urlInput.value.trim());
                });
            }
        })();
    </script>
}
