@model IEnumerable<Product>
@{
    ViewData["Title"] = "Productos";
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-cup-straw me-2"></i>Nuestros jugos</h1>
        <div class="section-divider"></div>
        <p class="subtitle mb-0">Botellas individuales y paquetes de 12 · 100% naturales</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Crear producto
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm">
        <i class="bi bi-info-circle me-1"></i>
        Todavía no hay productos. @if (User.IsInRole("Admin")) { <span>Crea el primero.</span> }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            var isPack = (product.Category ?? "").Contains("Pack", StringComparison.OrdinalIgnoreCase)
                      || (product.Category ?? "").Contains("12", StringComparison.OrdinalIgnoreCase);
            <div class="col-md-6 col-lg-4">
                <div class="card product-card h-100">
                    <img src="@(string.IsNullOrWhiteSpace(product.ImageUrl) ? "https://placehold.co/800x500/e8f8ef/1a5c3a?text=Tropivalle" : product.ImageUrl)"
                         class="card-img-top product-image" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        @if (isPack)
                        {
                            <span class="badge badge-pack align-self-start mb-2">
                                <i class="bi bi-box-seam me-1"></i>@(product.Category ?? "Pack x12")
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-individual align-self-start mb-2">
                                <i class="bi bi-bottle me-1"></i>@(product.Category ?? "Individual")
                            </span>
                        }
                        <h5 class="card-title fw-bold" style="color: var(--tv-green-dark);">@product.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                        <div class="mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="price-tag">@product.Price.ToString("C")</span>
                                <span class="@(product.Stock > 10 ? "stock-ok" : "stock-low") small">
                                    <i class="bi bi-box me-1"></i>Stock: @product.Stock
                                </span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                    Ver detalle
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-warning btn-sm">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
