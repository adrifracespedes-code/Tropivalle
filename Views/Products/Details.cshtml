@model Product
@{
    ViewData["Title"] = Model.Name;
    var isPack = (Model.Category ?? "").Contains("Pack", StringComparison.OrdinalIgnoreCase)
              || (Model.Category ?? "").Contains("12", StringComparison.OrdinalIgnoreCase);
}

<div class="row g-4 align-items-start">
    <div class="col-md-6">
        <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "https://placehold.co/900x600/e8f8ef/1a5c3a?text=Tropivalle" : Model.ImageUrl)"
             class="img-fluid rounded-4 shadow-sm w-100" style="object-fit: cover; max-height: 420px;" alt="@Model.Name" />
    </div>
    <div class="col-md-6">
        @if (isPack)
        {
            <span class="badge badge-pack mb-2"><i class="bi bi-box-seam me-1"></i>@(Model.Category ?? "Pack x12")</span>
        }
        else
        {
            <span class="badge badge-individual mb-2"><i class="bi bi-bottle me-1"></i>@(Model.Category ?? "Individual")</span>
        }
        <h1 class="fw-bold" style="color: var(--tv-green-dark);">@Model.Name</h1>
        <div class="section-divider"></div>
        <p class="lead text-muted">@Model.Description</p>
        <p class="price-tag mb-2" style="font-size: 1.75rem;">@Model.Price.ToString("C")</p>
        <p class="@(Model.Stock > 10 ? "stock-ok" : "stock-low")">
            <i class="bi bi-box me-1"></i><strong>Stock:</strong> @Model.Stock unidades
        </p>
        <p class="text-muted small">Publicado: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
            }
        </div>
    </div>
</div>
