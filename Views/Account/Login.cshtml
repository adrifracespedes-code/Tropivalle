@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <div class="card-header-tv">
                <h2><i class="bi bi-droplet-half me-2"></i>Tropivalle</h2>
                <p>Jugos naturales del valle</p>
            </div>
            <div class="card-body">
                <h5 class="text-center mb-4" style="color: var(--tv-green-dark);">Iniciar sesión</h5>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Correo electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-success"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" autocomplete="email" placeholder="tu@correo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-success"></i></span>
                            <input asp-for="Password" class="form-control border-start-0" autocomplete="current-password" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                    </button>
                </form>

                <p class="mt-4 mb-0 text-center text-muted">
                    ¿No tienes cuenta?
                    <a asp-action="Register" class="fw-semibold" style="color: var(--tv-green);">Registrarse</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
