@model IEnumerable<Sale>
@{
    ViewData["Title"] = "Reporte de ventas";
    var period = (string)(ViewBag.Period ?? "mensual");
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
    var total = (decimal)ViewBag.Total;
    var units = (int)ViewBag.Units;
    var periodLabel = period switch
    {
        "semanal" => "Semanal",
        "anual" => "Anual",
        _ => "Mensual"
    };
    var toDisplay = to.ToLocalTime().AddSeconds(-1);
}

<div class="report-toolbar no-print page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-file-earmark-text me-2"></i>Reporte de ventas</h1>
        <div class="section-divider"></div>
        <p class="subtitle mb-0">
            @periodLabel · @from.ToLocalTime().ToString("dd/MM/yyyy") — @toDisplay.ToString("dd/MM/yyyy")
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportPdf" asp-route-period="@period" class="btn btn-primary">
            <i class="bi bi-file-earmark-pdf me-1"></i>Descargar PDF
        </a>
        <button type="button" class="btn btn-outline-primary" id="btnPrintReport">
            <i class="bi bi-printer me-1"></i>Imprimir
        </button>
        <a asp-action="List" asp-route-period="@period" class="btn btn-outline-primary">Volver al listado</a>
    </div>
</div>

<div class="report-print-area" id="reportPrintArea">
    <div class="report-sheet card border-0 shadow-sm">
        <div class="card-body report-body">

            <div class="report-header text-center">
                <img src="~/images/logo-tropivalle.png"
                     alt="TropiValle"
                     class="report-logo"
                     asp-append-version="true" />
                <h2 class="report-company">Industrias Alimenticias TropiValle</h2>
                <div class="report-title">Reporte de ventas — @periodLabel</div>
                <div class="report-meta">
                    Periodo: @from.ToLocalTime().ToString("dd/MM/yyyy") — @toDisplay.ToString("dd/MM/yyyy")
                    &nbsp;·&nbsp;
                    Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                </div>
                <hr class="report-line" />
            </div>

            <div class="row g-3 mb-4 report-kpis">
                <div class="col-4">
                    <div class="report-kpi">
                        <div class="report-kpi-label">Total vendido</div>
                        <div class="report-kpi-value">@total.ToString("N2") BOB</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="report-kpi">
                        <div class="report-kpi-label">Unidades</div>
                        <div class="report-kpi-value">@units</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="report-kpi">
                        <div class="report-kpi-label">Registros</div>
                        <div class="report-kpi-value">@Model.Count()</div>
                    </div>
                </div>
            </div>

            <table class="table table-sm table-bordered report-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-end">Cant.</th>
                        <th class="text-end">P. unit.</th>
                        <th class="text-end">Total (BOB)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Sin ventas en este periodo.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.SoldAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@s.ProductName</td>
                                <td>@(s.Category ?? "—")</td>
                                <td class="text-end">@s.Quantity</td>
                                <td class="text-end">@s.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@s.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3"><strong>TOTAL</strong></td>
                        <td class="text-end"><strong>@units</strong></td>
                        <td></td>
                        <td class="text-end"><strong>@total.ToString("N2") BOB</strong></td>
                    </tr>
                </tfoot>
            </table>

            <div class="report-footer-info">
                Calle Salazar No. 1691 · Zona La Chimba · Cochabamba, Bolivia · +591-7-595-0776
            </div>

        </div>
    </div>
</div>

<style>
    .report-logo {
        height: 72px;
        width: auto;
        object-fit: contain;
        margin-bottom: 0.5rem;
    }

    .report-company {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0d3b2a;
        margin: 0 0 0.25rem;
    }

    .report-title {
        font-size: 1rem;
        color: #456;
        margin-bottom: 0.25rem;
    }

    .report-meta {
        font-size: 0.85rem;
        color: #6a7a72;
    }

    .report-line {
        border: 0;
        border-top: 2px solid #1a6b45;
        opacity: 1;
        margin: 1rem auto 1.25rem;
    }

    .report-kpi {
        background: #f0f5f1;
        border: 1px solid #d8e5dc;
        border-radius: 10px;
        padding: 0.85rem 1rem;
        text-align: center;
    }

    .report-kpi-label {
        font-size: 0.75rem;
        color: #5a7a6a;
        text-transform: uppercase;
    }

    .report-kpi-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #0d3b2a;
    }

    .report-table thead th {
        background: #1a6b45 !important;
        color: #fff !important;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .report-table tfoot td {
        background: #e8f5ec;
    }

    .report-footer-info {
        margin-top: 1.25rem;
        font-size: 0.8rem;
        color: #6a7a72;
        text-align: center;
    }
</style>

@section Scripts {
    <script>
        (function() {
            var btn = document.getElementById('btnPrintReport');
            if (!btn) return;

            btn.addEventListener('click', function() {
                var area = document.getElementById('reportPrintArea');
                if (!area) {
                    alert('No se encontró el contenido del reporte.');
                    return;
                }

                var logo = area.querySelector('.report-logo');
                var logoSrc = logo ? logo.src : '';
                var html = area.innerHTML;

                if (logoSrc) {
                    html = html.replace(/src="[^"]*logo-tropivalle[^"]*"/i, 'src="' + logoSrc + '"');
                }

                var win = window.open('', '_blank', 'noopener,noreferrer,width=900,height=700');
                if (!win) {
                    alert('El navegador bloqueó la ventana de impresión. Permite ventanas emergentes o usa "Descargar PDF".');
                    return;
                }

                win.document.open();
                win.document.write(
                    '<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/>' +
                    '<title>Reporte TropiValle</title>' +
                    '<style>' +
                    'body{font-family:Segoe UI,Arial,sans-serif;color:#111;margin:16px;}' +
                    '.report-sheet,.card{border:none!important;box-shadow:none!important;}' +
                    '.report-body{padding:0!important;}' +
                    '.report-logo{height:56px;width:auto;display:block;margin:0 auto 8px;}' +
                    '.report-header{text-align:center;}' +
                    '.report-company{font-size:16px;font-weight:700;color:#0d3b2a;margin:0 0 4px;}' +
                    '.report-title{font-size:14px;color:#456;margin-bottom:4px;}' +
                    '.report-meta{font-size:12px;color:#666;}' +
                    '.report-line{border:0;border-top:2px solid #1a6b45;margin:12px 0 16px;}' +
                    '.report-kpis{display:flex;gap:12px;margin-bottom:16px;}' +
                    '.report-kpis .col-4{flex:1;}' +
                    '.report-kpi{background:#f0f5f1;border:1px solid #ccc;border-radius:8px;padding:10px;text-align:center;}' +
                    '.report-kpi-label{font-size:11px;color:#5a7a6a;text-transform:uppercase;}' +
                    '.report-kpi-value{font-size:18px;font-weight:700;color:#0d3b2a;}' +
                    'table.report-table{width:100%;border-collapse:collapse;font-size:12px;}' +
                    'table.report-table th,table.report-table td{border:1px solid #333;padding:5px 6px;}' +
                    'table.report-table thead th{background:#1a6b45;color:#fff;}' +
                    'table.report-table tfoot td{background:#e8f5ec;font-weight:700;}' +
                    '.text-end{text-align:right;}' +
                    '.report-footer-info{margin-top:16px;font-size:11px;color:#666;text-align:center;}' +
                    '@@media print{body{margin:0;}}' +
                    '</style></head><body>' + html + '</body></html>'
                );
                win.document.close();

                setTimeout(function() {
                    try {
                        win.focus();
                        win.print();
                    } catch (e) {
                        alert('No se pudo abrir el diálogo de impresión. Usa "Descargar PDF".');
                    }
                }, 400);
            });
        })();
    </script>
}