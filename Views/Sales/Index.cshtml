@{
    ViewData["Title"] = "Ventas";
    var period = (string)(ViewBag.Period ?? "mensual");
    dynamic summary = ViewBag.Summary!;
}
<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-pie-chart-fill me-2"></i>Ventas activas</h1>
        <div class="section-divider"></div>
        <p class="subtitle mb-0">Gráfica circular · Semanal · Mensual · Anual</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Registrar venta</a>
        <a asp-action="List" asp-route-period="@period" class="btn btn-outline-primary"><i class="bi bi-list-ul me-1"></i>Listado</a>
        <a asp-action="Report" asp-route-period="@period" class="btn btn-outline-primary"><i class="bi bi-file-earmark-text me-1"></i>Reporte</a>
        <a asp-action="ExportPdf" asp-route-period="@period" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
    </div>
</div>

<!-- Periodo -->
<div class="catalog-toolbar card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <label class="form-label small text-muted mb-1 fw-semibold">Periodo</label>
                <div class="btn-group" role="group">
                    <a asp-action="Index" asp-route-period="semanal"
                       class="btn btn-sm btn-outline-success @(period == "semanal" ? "active" : "")">Semanal</a>
                    <a asp-action="Index" asp-route-period="mensual"
                       class="btn btn-sm btn-outline-success @(period == "mensual" ? "active" : "")">Mensual</a>
                    <a asp-action="Index" asp-route-period="anual"
                       class="btn btn-sm btn-outline-success @(period == "anual" ? "active" : "")">Anual</a>
                </div>
            </div>
            <div>
                <label class="form-label small text-muted mb-1 fw-semibold">Agrupar por</label>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm btn-outline-success active" id="btnCat" onclick="loadChart('categoria')">Categoría</button>
                    <button type="button" class="btn btn-sm btn-outline-success" id="btnProd" onclick="loadChart('producto')">Producto</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 sales-kpi">
            <div class="card-body">
                <div class="text-muted small">Total vendido (@period)</div>
                <div class="fs-3 fw-bold" style="color: var(--tv-green-dark);">@(((decimal)summary.Total).ToString("N2")) BOB</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 sales-kpi">
            <div class="card-body">
                <div class="text-muted small">Unidades</div>
                <div class="fs-3 fw-bold" style="color: var(--tv-green-dark);">@summary.Units</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 sales-kpi">
            <div class="card-body">
                <div class="text-muted small">Registros de venta</div>
                <div class="fs-3 fw-bold" style="color: var(--tv-green-dark);">@summary.Rows</div>
            </div>
        </div>
    </div>
</div>

<!-- Gráfica circular -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Distribución de ventas</h2>
                <div class="chart-wrap">
                    <canvas id="salesChart" aria-label="Gráfica circular de ventas"></canvas>
                </div>
                <p class="text-muted small text-center mt-2 mb-0" id="chartEmpty" style="display:none;">
                    No hay ventas en este periodo. <a asp-action="Create">Registrar una venta</a>
                </p>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Detalle</h2>
                <ul class="list-group list-group-flush" id="legendList"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
<script>
(function () {
    const period = '@period';
    const colors = [
        '#1a6b45', '#2db85c', '#9af00a', '#0d3b2a', '#57c38a',
        '#c8ff4a', '#3d9b6a', '#7ed99a', '#145c3a', '#a8e06c'
    ];
    let chart = null;
    let currentGroup = 'categoria';

    window.loadChart = async function (groupBy) {
        currentGroup = groupBy || currentGroup;
        document.getElementById('btnCat').classList.toggle('active', currentGroup === 'categoria');
        document.getElementById('btnProd').classList.toggle('active', currentGroup === 'producto');

        const res = await fetch(`/Sales/ChartData?period=${encodeURIComponent(period)}&groupBy=${encodeURIComponent(currentGroup)}`);
        const data = await res.json();
        const empty = !data.labels || data.labels.length === 0;
        document.getElementById('chartEmpty').style.display = empty ? 'block' : 'none';

        const legend = document.getElementById('legendList');
        legend.innerHTML = '';
        if (empty) {
            legend.innerHTML = '<li class="list-group-item text-muted">Sin datos</li>';
        } else {
            data.labels.forEach((label, i) => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center px-0';
                li.innerHTML = `<span><span class="legend-dot" style="background:${colors[i % colors.length]}"></span> ${label}</span>
                    <strong>${Number(data.values[i]).toFixed(2)} BOB</strong>`;
                legend.appendChild(li);
            });
        }

        const ctx = document.getElementById('salesChart');
        if (chart) chart.destroy();
        chart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: data.labels || [],
                datasets: [{
                    data: data.values || [],
                    backgroundColor: colors,
                    borderWidth: 2,
                    borderColor: '#fff',
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                cutout: '58%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => {
                                const v = ctx.parsed || 0;
                                const sum = (ctx.dataset.data || []).reduce((a, b) => a + b, 0) || 1;
                                const pct = ((v / sum) * 100).toFixed(1);
                                return ` ${ctx.label}: ${v.toFixed(2)} BOB (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });
    };

    loadChart('categoria');
})();
</script>
}
